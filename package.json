{
  "name": "dsh-secretary",
  "version": "0.2.0",
  "description": "DSH 侧边栏里的个人秘书：便签画布 + 线程任务卡 + 定时简报/周报 + 永久 token 台账（不估费用）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "src",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "build-client.mjs",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build-client.mjs",
    "test": "node --test test/*.test.mjs",
    "test:panel": "node test/panel.render.mjs",
    "prepublishOnly": "node build-client.mjs && node --test test/*.test.mjs"
  },
  "author": "cozcc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cozcc/dsh-secretary.git"
  },
  "homepage": "https://github.com/cozcc/dsh-secretary#readme",
  "bugs": {
    "url": "https://github.com/cozcc/dsh-secretary/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sticky-notes",
    "assistant",
    "secretary",
    "briefing",
    "tokens"
  ],
  "engines": {
    "node": ">=22"
  }
}
